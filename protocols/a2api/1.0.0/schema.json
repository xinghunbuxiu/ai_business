{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-business.dev/protocols/a2api/1.0.0/schema.json",
  "title": "A2API Capability Asset 1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolVersion",
    "id",
    "version",
    "kind",
    "name",
    "inputSchema",
    "outputSchema",
    "auth",
    "mapping",
    "idempotency"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "protocolVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
    },
    "kind": {
      "const": "a2api"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "testing",
        "published",
        "deprecated"
      ]
    },
    "visibility": {
      "enum": [
        "system",
        "tenant",
        "private"
      ]
    },
    "tenantId": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "roles"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "tenantRequired": {
          "type": "boolean"
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mapping": {
      "type": "object",
      "required": [
        "adapter",
        "operation"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "idempotency": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "keyFrom": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
