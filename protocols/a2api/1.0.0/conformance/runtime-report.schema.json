{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sass-a2ui-platform.dev/protocols/a2api/1.0.0/conformance/runtime-report.schema.json",
  "title": "A2API Runtime Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportVersion",
    "protocol",
    "protocolVersion",
    "runtime",
    "adapter",
    "adapterCommitSha",
    "corpus",
    "generatedAt",
    "summary",
    "vectors"
  ],
  "properties": {
    "reportVersion": {
      "const": "1.0.0"
    },
    "protocol": {
      "const": "A2API"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "adapterCommitSha": {
      "type": "string",
      "minLength": 1
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "unsupported",
        "notExecuted"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "notExecuted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unsupported",
              "not_executed"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  }
}
