{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-business.dev/protocols/a2wf/1.0.0/schema.json",
  "title": "A2WF Workflow Asset 1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolVersion",
    "id",
    "version",
    "kind",
    "name",
    "trigger",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "protocolVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
    },
    "kind": {
      "const": "a2wf"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "testing",
        "published",
        "deprecated"
      ]
    },
    "visibility": {
      "enum": [
        "system",
        "tenant",
        "private"
      ]
    },
    "tenantId": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "intents"
      ],
      "properties": {
        "intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "capability",
              "capabilityVersion"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "action"
              },
              "capability": {
                "type": "string"
              },
              "capabilityVersion": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
              },
              "input": {
                "type": "object"
              },
              "requiresConfirmation": {
                "type": "boolean"
              },
              "next": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "component",
              "componentVersion"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "form"
              },
              "component": {
                "type": "string"
              },
              "componentVersion": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
              },
              "input": {
                "type": "object"
              },
              "next": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "approval"
              },
              "next": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "condition",
              "onTrue",
              "onFalse"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "condition"
              },
              "condition": {
                "type": "object",
                "required": [
                  "path",
                  "operator"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "operator": {
                    "enum": [
                      "eq",
                      "neq",
                      "exists",
                      "truthy"
                    ]
                  },
                  "value": {}
                }
              },
              "onTrue": {
                "type": "string"
              },
              "onFalse": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "end"
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
