{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-business.dev/protocols/a2ui/1.0.0/schema.json",
  "title": "A2UI Component Asset 1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolVersion",
    "id",
    "version",
    "kind",
    "name",
    "component",
    "propsSchema",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "protocolVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+(?:-[A-Za-z0-9.-]+)?$"
    },
    "kind": {
      "const": "a2ui"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "testing",
        "published",
        "deprecated"
      ]
    },
    "visibility": {
      "enum": [
        "system",
        "tenant",
        "private"
      ]
    },
    "tenantId": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+(?:-[A-Za-z0-9.-]+)?$"
          }
        }
      }
    },
    "component": {
      "enum": [
        "Form",
        "Table",
        "Card",
        "List",
        "Chart",
        "OrderSummary",
        "EmployeeForm"
      ]
    },
    "propsSchema": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "target"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "required": [
              "kind",
              "id",
              "version"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "a2api",
                  "a2wf"
                ]
              },
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+(?:-[A-Za-z0-9.-]+)?$"
              }
            }
          }
        }
      }
    },
    "layout": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
